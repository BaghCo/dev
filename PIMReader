#requires -Version 7.0
<#
.SYNOPSIS
    Export Azure-resource PIM role settings as a management-group hierarchy.
.DESCRIPTION
    Read-only. Uses Azure Resource Manager, not Microsoft Graph or AzGovViz.
    Discovers the management-group / subscription tree, lists role management policy
    assignments and the corresponding role management policies at each scope,
    and saves a collapsible HTML tree, text tree, summary CSV, rule CSV and JSON.
    Diagnostics are written during scanning as well as in the final report.
    ARM timeouts are retried, temporary file-sharing violations cannot stop
    collection, and MG/subscription policies are read before resource groups.
    A 404 on a resource-group PIM API is checked against the resource-group GET
    endpoint before calling that group missing; failed scopes are not counted
    as empty configuration.

    Coverage defaults to management groups and subscriptions. Choose ResourceGroups
    or Resources to examine those levels too. Individual resources can cause a
    large number of ARM requests. A scope with no results is not the same as a
    scope for which the API returned an error: errors are reported separately.

    PIM role policies DO NOT inherit down the management-group hierarchy.
    Azure RBAC role assignments may inherit, but PIM role *settings* do not.

    Excludes Microsoft Entra directory-role PIM and PIM for Groups (Graph APIs).
    Does not enumerate PIM eligible or active *principal* assignments.
.EXAMPLE
    Connect-AzAccount -Tenant '<tenant-guid>'
    ./Get-AzurePimPolicyTree-v4.ps1
.EXAMPLE
    ./Get-AzurePimPolicyTree-v4.ps1 -ManagementGroupId 'platform' -ScopeDepth ResourceGroups
.EXAMPLE
    ./Get-AzurePimPolicyTree-v4.ps1 -ScopeDepth Resources -OutputDirectory ./PimFull -FailOnErrors
.EXAMPLE
    ./Get-AzurePimPolicyTree-v4.ps1 -SubscriptionId (Get-AzContext).Subscription.Id
    # Bypass management-group enumeration to verify an accessible subscription.
.NOTES
    Requires Az.Accounts and an authenticated Azure context in the target tenant.
    Grant Reader access on the starting management group and its descendants,
    including subscriptions, for a complete report. No permissions are elevated.
#>
[CmdletBinding()]
param(
    [string] $ManagementGroupId,
    [string] $SubscriptionId,
    [ValidateSet('ManagementGroupsAndSubscriptions', 'ResourceGroups', 'Resources')]
    [string] $ScopeDepth = 'ManagementGroupsAndSubscriptions',
    [string] $OutputDirectory = (Join-Path (Get-Location).Path 'AzurePimReport'),
    [switch] $NoRoleNameResolution,
    [switch] $FailOnErrors,
    [switch] $AllowEmpty
)

$ErrorActionPreference = 'Stop'
Import-Module Az.Accounts -ErrorAction Stop
$context = Get-AzContext
if (-not $context -or -not $context.Tenant -or -not $context.Tenant.Id) {
    throw 'No Azure context. Run Connect-AzAccount -Tenant <tenant-id> first.'
}
if ($SubscriptionId -and $ManagementGroupId) {
    throw 'Choose one starting scope: -ManagementGroupId or -SubscriptionId.'
}
if ($SubscriptionId -and $SubscriptionId -notmatch '^[0-9a-fA-F]{8}-(?:[0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$') {
    throw 'SubscriptionId must be the subscription GUID (without /subscriptions/).'
}
if (-not $SubscriptionId -and [string]::IsNullOrWhiteSpace($ManagementGroupId)) {
    $ManagementGroupId = [string] $context.Tenant.Id
}

$script:Nodes = @{}
$script:AllNodes = [System.Collections.Generic.List[object]]::new()
$script:AllPolicies = [System.Collections.Generic.List[object]]::new()
$script:Errors = [System.Collections.Generic.List[object]]::new()
$script:Requests = [System.Collections.Generic.List[object]]::new()
$script:RoleNames = @{}
$script:RootNode = $null
$script:JournalWriteFailures = 0
$script:RecoveredPolicyWrites = 0

# Write diagnostics immediately so a failed or interrupted run still leaves evidence.
# These are separate from the final *_requests.csv, *_errors.csv and *_scopes.csv.
[void] (New-Item -ItemType Directory -Path $OutputDirectory -Force -ErrorAction Stop)
$out = (Resolve-Path -Path $OutputDirectory -ErrorAction Stop).Path
$stamp = '{0}_{1}' -f (Get-Date -Format 'yyyyMMdd_HHmmss_fff'), ([guid]::NewGuid().ToString('N').Substring(0,8))
$stem = Join-Path $out "AzurePim_$stamp"
$script:LiveRequestsPath = "${stem}_requests.live.csv"
$script:LiveErrorsPath = "${stem}_errors.live.csv"
$script:LiveScopesPath = "${stem}_scopes.live.csv"
$script:LivePoliciesPath = "${stem}_policies.partial.jsonl"
$script:PolicyRecoveryDirectory = "${stem}_policies.recovery"
"Path,Result,ItemCount,Error" | Set-Content -Path $script:LiveRequestsPath -Encoding utf8
"ScopeId,Operation,Error" | Set-Content -Path $script:LiveErrorsPath -Encoding utf8
"ScopeId,ScopeKind,Status,AssignmentCount,PolicyCount,PolicyRecords" | Set-Content -Path $script:LiveScopesPath -Encoding utf8
[System.IO.File]::WriteAllText($script:LivePoliciesPath, '')
Write-Host "PIM collection started. Live diagnostics: $out" -ForegroundColor Cyan

function Write-LiveCsvRow {
    param([string] $Path, [object] $Row)
    # Live diagnostics are best effort. A temporary share lock from Excel,
    # antivirus or synchronisation must never stop an ARM scan or mask an error.
    for ($attempt = 1; $attempt -le 6; $attempt++) {
        try {
            $Row | Export-Csv -Path $Path -NoTypeInformation -Encoding utf8 -Append -ErrorAction Stop
            return
        }
        catch {
            $message = $_.Exception.Message
            $isLock = ($_.Exception -is [System.IO.IOException] -or $message -match '(?i)being used by another process|sharing violation|file.*locked')
            if ($isLock -and $attempt -lt 6) {
                Start-Sleep -Milliseconds (200 * $attempt)
                continue
            }
            $script:JournalWriteFailures++
            Write-Warning "Non-fatal diagnostic CSV write failure ($Path): $message. In-memory results are retained for the final export."
            return
        }
    }
}

function Write-LivePolicyRecord {
    param([Parameter(Mandatory)] $Record)
    # A policy is already saved in memory before this function is called.
    # If the shared JSONL file stays locked, use an independent recovery file.
    $json = ConvertTo-Json -InputObject $Record -Depth 60 -Compress
    for ($attempt = 1; $attempt -le 6; $attempt++) {
        try {
            [System.IO.File]::AppendAllText($script:LivePoliciesPath, ($json + [Environment]::NewLine), [System.Text.UTF8Encoding]::new($false))
            return
        }
        catch {
            $message = $_.Exception.Message
            $isLock = ($_.Exception -is [System.IO.IOException] -or $message -match '(?i)being used by another process|sharing violation|file.*locked')
            if ($isLock -and $attempt -lt 6) {
                Start-Sleep -Milliseconds (200 * $attempt)
                continue
            }
            break
        }
    }
    try {
        [void] (New-Item -ItemType Directory -Path $script:PolicyRecoveryDirectory -Force -ErrorAction Stop)
        $recoveryFile = Join-Path $script:PolicyRecoveryDirectory (([guid]::NewGuid().ToString('N')) + '.json')
        [System.IO.File]::WriteAllText($recoveryFile, $json, [System.Text.UTF8Encoding]::new($false))
        $script:RecoveredPolicyWrites++
        Write-Warning "Partial JSONL unavailable; policy saved to recovery file: $recoveryFile"
    }
    catch {
        $script:JournalWriteFailures++
        Write-Warning "Unable to checkpoint a policy record to disk: $($_.Exception.Message). Policy remains in memory for the final export."
    }
}

function Add-RequestRecord {
    param([string] $Path, [string] $Result, $ItemCount, [string] $Message = '')
    $record = [pscustomobject] @{
        Path = $Path; Result = $Result; ItemCount = $ItemCount; Error = $Message
    }
    [void] $script:Requests.Add($record)
    Write-LiveCsvRow -Path $script:LiveRequestsPath -Row $record
}

function Write-ScopeRecord {
    param($Node)
    Write-LiveCsvRow -Path $script:LiveScopesPath -Row ([pscustomobject] @{
        ScopeId = $Node.Id
        ScopeKind = $Node.Kind
        Status = $Node.Status
        AssignmentCount = $Node.ApiAssignmentCount
        PolicyCount = $Node.ApiPolicyCount
        PolicyRecords = $Node.Policies.Count
    })
}

function Invoke-ArmJson {
    param([Parameter(Mandatory)][string] $Path)

    for ($attempt = 1; $attempt -le 4; $attempt++) {
        $response = $null
        $requestParams = @{ Method = 'GET'; ErrorAction = 'Stop' }
        if ($Path -match '^https://') { $requestParams.Uri = [uri] $Path }
        else { $requestParams.Path = $Path }

        try {
            $response = Invoke-AzRestMethod @requestParams
        }
        catch {
            $message = $_.Exception.Message
            if ($attempt -lt 4 -and $message -match '(?i)(429|TooManyRequests|throttl|(?:^|\D)50[0234](?:\D|$)|temporar|timed?\s*out|time\s*out|timeout|operation\s+(?:was\s+)?cancell?ed|taskcanceledexception|connection\s+(?:was\s+)?(?:reset|closed))') {
                Start-Sleep -Seconds ([int][math]::Pow(2, $attempt))
                continue
            }
            throw "ARM GET failed for ${Path}: $message"
        }

        $status = [int] $response.StatusCode
        if (($status -eq 429 -or $status -ge 500) -and $attempt -lt 4) {
            Start-Sleep -Seconds ([int][math]::Pow(2, $attempt))
            continue
        }
        if ($status -lt 200 -or $status -ge 300) {
            $detail = [string] $response.Content
            try {
                $serverError = ConvertFrom-Json -InputObject $detail -Depth 100
                if ($serverError.error.message) { $detail = $serverError.error.message }
                if ($serverError.error.code) { $detail = "[$($serverError.error.code)] $detail" }
            }
            catch { }
            throw "ARM GET $status for ${Path}: $detail"
        }
        if ([string]::IsNullOrWhiteSpace([string] $response.Content)) { return $null }
        return ConvertFrom-Json -InputObject ([string] $response.Content) -Depth 100
    }
    throw "ARM request could not be completed: $Path"
}

function Get-ArmList {
    param([Parameter(Mandatory)][string] $Path)
    $next = $Path
    $seenLinks = @{}
    while (-not [string]::IsNullOrWhiteSpace($next)) {
        if ($seenLinks.ContainsKey($next)) { throw "Repeated ARM continuation link: $next" }
        $seenLinks[$next] = $true
        try {
            $result = Invoke-ArmJson -Path $next
            if ($null -eq $result -or $null -eq $result.PSObject.Properties['value']) {
                throw "Unexpected ARM list result (missing value): $next"
            }
            $items = @($result.value | Where-Object { $null -ne $_ })
            Add-RequestRecord -Path $next -Result 'OK' -ItemCount $items.Count
        }
        catch {
            Add-RequestRecord -Path $next -Result 'FAILED' -ItemCount $null -Message $_.Exception.Message
            throw
        }
        foreach ($item in $items) { Write-Output $item }
        $next = [string] $result.nextLink
    }
}

function Add-ReportError {
    param([string] $ScopeId, [string] $Operation, [string] $Message)
    $record = [pscustomobject] @{
        ScopeId = $ScopeId; Operation = $Operation; Error = $Message
    }
    [void] $script:Errors.Add($record)
    Write-LiveCsvRow -Path $script:LiveErrorsPath -Row $record
    Write-Warning "[$Operation] ${ScopeId}: $Message"
}

function Add-Node {
    param([string] $Id, [string] $Name, [string] $Kind, [string] $ParentId = '')
    $Id = $Id.TrimEnd('/')
    if ($script:Nodes.ContainsKey($Id)) { return $script:Nodes[$Id] }
    $node = [pscustomobject] @{
        Id = $Id
        Name = $(if ($Name) { $Name } else { ($Id -split '/')[-1] })
        Kind = $Kind
        ParentId = $ParentId
        Children = [System.Collections.Generic.List[object]]::new()
        Policies = [System.Collections.Generic.List[object]]::new()
        Status = 'Not scanned'
        ApiAssignmentCount = $null
        ApiPolicyCount = $null
        FilteredAssignmentCount = 0
        FilteredPolicyCount = 0
    }
    $script:Nodes[$Id] = $node
    [void] $script:AllNodes.Add($node)
    if ($ParentId -and $script:Nodes.ContainsKey($ParentId)) {
        [void] $script:Nodes[$ParentId].Children.Add($node)
    }
    return $node
}

function Add-ManagementGroupChildren {
    param($Children, [string] $ParentId)
    foreach ($child in @($Children)) {
        if ($null -eq $child -or -not $child.id) { continue }
        if ([string] $child.type -match '(?i)managementgroups') {
            $kind = 'ManagementGroup'
        }
        elseif ([string] $child.id -match '(?i)^/subscriptions/') {
            $kind = 'Subscription'
        }
        else {
            Add-ReportError -ScopeId $ParentId -Operation 'Hierarchy' -Message "Unexpected hierarchy child: $($child.id)"
            continue
        }
        [void] (Add-Node -Id $child.id -Name $child.displayName -Kind $kind -ParentId $ParentId)
        if ($kind -eq 'ManagementGroup') {
            Add-ManagementGroupChildren -Children $child.children -ParentId $child.id
        }
    }
}

function Test-ArmNotFoundMessage {
    param([string] $Message)
    # Invoke-AzRestMethod may return a response or throw, depending on version.
    # Match common 404/status phrases without confusing a scope name ending in 404
    # for an HTTP result.
    return [bool] ($Message -match '(?i)(ARM GET\s+404\b|\bHTTP\s*404\b|\bstatus(?:\s*code)?\s*[:=]?\s*404\b|\b404\s+Not\s+Found\b|\bResourceGroupNotFound\b)')
}

function Test-ResourceGroupAfter404 {
    param([Parameter(Mandatory)][string] $ScopeId)
    # Only call this following a 404 from a PIM endpoint. The RG list was
    # already retrieved from ARM, but a RG can be deleted during a long scan.
    # 404 for *the policy endpoint* is not by itself proof the RG is missing.
    $path = '{0}?api-version=2021-04-01' -f $ScopeId.TrimEnd('/')
    try {
        $rg = Invoke-ArmJson -Path $path
        Add-RequestRecord -Path $path -Result 'OK' -ItemCount 1
        if ($null -ne $rg -and ([string] $rg.id).TrimEnd('/') -ieq $ScopeId.TrimEnd('/')) {
            return 'Exists'
        }
        Add-ReportError -ScopeId $ScopeId -Operation 'Verify resource group' -Message 'Resource-group GET returned unexpected content.'
        return 'Unknown'
    }
    catch {
        $message = $_.Exception.Message
        Add-RequestRecord -Path $path -Result 'FAILED' -ItemCount $null -Message $message
        if (Test-ArmNotFoundMessage -Message $message) { return 'Missing' }
        Add-ReportError -ScopeId $ScopeId -Operation 'Verify resource group' -Message "Could not confirm resource-group existence: $message"
        return 'Unknown'
    }
}

function Get-Rule {
    param([object[]] $Rules, [string] $RuleId)
    foreach ($r in $Rules) {
        if ($null -ne $r -and [string] $r.id -ieq $RuleId) { return $r }
    }
    return $null
}

function Bool-Text {
    param($Value)
    if ($null -eq $Value) { return '?' }
    if ([bool] $Value) { return 'Yes' }
    return 'No'
}

function Get-PolicySummary {
    param([object[]] $Rules)
    $enable = Get-Rule -Rules $Rules -RuleId 'Enablement_EndUser_Assignment'
    $expiry = Get-Rule -Rules $Rules -RuleId 'Expiration_EndUser_Assignment'
    $approval = Get-Rule -Rules $Rules -RuleId 'Approval_EndUser_Assignment'
    $contextRule = Get-Rule -Rules $Rules -RuleId 'AuthenticationContext_EndUser_Assignment'
    $eligible = Get-Rule -Rules $Rules -RuleId 'Expiration_Admin_Eligibility'
    $active = Get-Rule -Rules $Rules -RuleId 'Expiration_Admin_Assignment'

    $flags = @()
    if ($null -ne $enable) { $flags = @($enable.enabledRules) }
    $mfa = if ($null -eq $enable) { $null } else { [bool] ($flags -contains 'MultiFactorAuthentication') }
    $just = if ($null -eq $enable) { $null } else { [bool] ($flags -contains 'Justification') }
    $ticket = if ($null -eq $enable) { $null } else { [bool] ($flags -contains 'Ticketing') }
    $approvalRequired = if ($null -eq $approval) { $null } else { $approval.setting.isApprovalRequired }
    $conditionalAccess = if ($null -eq $contextRule) { $null } else { $contextRule.isEnabled }

    $approvers = [System.Collections.Generic.List[string]]::new()
    if ($null -ne $approval) {
        foreach ($stage in @($approval.setting.approvalStages)) {
            if ($null -eq $stage) { continue }
            foreach ($person in @($stage.primaryApprovers)) {
                if ($null -eq $person) { continue }
                if ($person.description) { [void] $approvers.Add([string] $person.description) }
                elseif ($person.id) { [void] $approvers.Add([string] $person.id) }
            }
        }
    }
    $notificationCount = @($Rules | Where-Object { $_.ruleType -eq 'RoleManagementPolicyNotificationRule' }).Count
    $eligiblePermanent = if ($null -eq $eligible) { $null } else { -not [bool] $eligible.isExpirationRequired }
    $activePermanent = if ($null -eq $active) { $null } else { -not [bool] $active.isExpirationRequired }

    return [pscustomobject] @{
        ActivationMaxDuration = $(if ($expiry) { $expiry.maximumDuration } else { $null })
        ActivationMFA = $mfa
        ActivationJustification = $just
        ActivationTicket = $ticket
        ActivationApproval = $approvalRequired
        ApprovalApprovers = ($approvers -join '; ')
        ConditionalAccessContextEnabled = $conditionalAccess
        ConditionalAccessContextId = $(if ($contextRule) { $contextRule.claimValue } else { $null })
        EligiblePermanentAllowed = $eligiblePermanent
        EligibleMaxDuration = $(if ($eligible) { $eligible.maximumDuration } else { $null })
        ActivePermanentAllowed = $activePermanent
        ActiveMaxDuration = $(if ($active) { $active.maximumDuration } else { $null })
        NotificationRuleCount = $notificationCount
    }
}

function New-PolicyRecord {
    param($Node, $Assignment, $Policy, [string] $PolicyId, [string] $RoleDefinitionId)
    $rules = @()
    if ($null -ne $Policy -and $null -ne $Policy.properties.effectiveRules -and @($Policy.properties.effectiveRules).Count -gt 0) {
        $rules = @($Policy.properties.effectiveRules)
    }
    elseif ($null -ne $Policy -and $null -ne $Policy.properties.rules -and @($Policy.properties.rules).Count -gt 0) {
        $rules = @($Policy.properties.rules)
    }
    elseif ($null -ne $Assignment) {
        $rules = @($Assignment.properties.effectiveRules | Where-Object { $null -ne $_ })
    }

    $summary = Get-PolicySummary -Rules $rules
    $roleGuid = if ($RoleDefinitionId) { ($RoleDefinitionId.TrimEnd('/') -split '/')[-1] } else { '' }
    $record = [pscustomobject] @{
        ScopeId = $Node.Id
        ScopeName = $Node.Name
        ScopeKind = $Node.Kind
        RoleName = $(if ($roleGuid) { $roleGuid } else { '[Unmapped policy]' })
        RoleDefinitionId = $RoleDefinitionId
        RoleDefinitionGuid = $roleGuid
        PolicyId = $PolicyId
        IsOrganisationDefault = $(if ($Policy) { $Policy.properties.isOrganizationDefault } else { $null })
        LastModified = $(if ($Policy) { $Policy.properties.lastModifiedDateTime } else { $null })
        Summary = $summary
        Rules = $rules
        PolicyRaw = $Policy
        AssignmentRaw = $Assignment
    }
    [void] $Node.Policies.Add($record)
    [void] $script:AllPolicies.Add($record)
    # Save before final HTML/CSV export. File-sharing violations are non-fatal.
    Write-LivePolicyRecord -Record $record
}

function Read-ScopePolicies {
    param($Node)
    Write-Progress -Activity 'Reading Azure PIM settings' -Status "[$($script:AllPolicies.Count) policies] $($Node.Kind): $($Node.Name)" -PercentComplete -1
    $scope = $Node.Id
    $assignments = @()
    $policies = @()
    $assignmentsOK = $false
    $policiesOK = $false
    $rgExistence = 'NotChecked'
    $assignmentPath = '{0}/providers/Microsoft.Authorization/roleManagementPolicyAssignments?api-version=2020-10-01' -f $scope
    $policyPath = '{0}/providers/Microsoft.Authorization/roleManagementPolicies?api-version=2020-10-01' -f $scope

    try {
        $assignments = @(Get-ArmList -Path $assignmentPath)
        $assignmentsOK = $true
        $Node.ApiAssignmentCount = $assignments.Count
    }
    catch {
        $message = $_.Exception.Message
        if ($Node.Kind -eq 'ResourceGroup' -and (Test-ArmNotFoundMessage -Message $message)) {
            $rgExistence = Test-ResourceGroupAfter404 -ScopeId $scope
            if ($rgExistence -eq 'Missing') {
                $Node.Status = 'MISSING / ERROR'
                Add-ReportError -ScopeId $scope -Operation 'Resource group missing since enumeration' -Message "Resource-group GET also returned 404. The group was listed earlier but is now missing; PIM settings not assessed. Original error: $message"
                return
            }
            if ($rgExistence -eq 'Exists') {
                $message = "PIM policy-assignment endpoint returned 404 although the resource group exists. $message"
            }
        }
        Add-ReportError -ScopeId $scope -Operation 'List policy assignments' -Message $message
    }

    try {
        $policies = @(Get-ArmList -Path $policyPath)
        $policiesOK = $true
        $Node.ApiPolicyCount = $policies.Count
    }
    catch {
        $message = $_.Exception.Message
        if ($Node.Kind -eq 'ResourceGroup' -and (Test-ArmNotFoundMessage -Message $message)) {
            if ($rgExistence -eq 'NotChecked') {
                $rgExistence = Test-ResourceGroupAfter404 -ScopeId $scope
            }
            if ($rgExistence -eq 'Missing') {
                $Node.Status = 'MISSING / ERROR'
                Add-ReportError -ScopeId $scope -Operation 'Resource group missing since enumeration' -Message "Resource-group GET also returned 404. The group was listed earlier but is now missing; PIM settings not assessed. Original error: $message"
                return
            }
            if ($rgExistence -eq 'Exists') {
                $message = "PIM policy endpoint returned 404 although the resource group exists. $message"
            }
        }
        Add-ReportError -ScopeId $scope -Operation 'List policies' -Message $message
    }

    # Some list operations can include policy objects belonging to a different scope.
    # Never misrepresent a parent policy as being configured on a descendant.
    $policies = @($policies | Where-Object {
        -not $_.properties.scope -or ([string] $_.properties.scope).TrimEnd('/') -ieq $scope.TrimEnd('/')
    })
    if ($policiesOK) { $Node.FilteredPolicyCount = $Node.ApiPolicyCount - $policies.Count }
    $byId = @{}
    foreach ($p in $policies) {
        if ($p.id) { $byId[[string] $p.id.TrimEnd('/')] = $p }
    }
    $matched = @{}
    foreach ($a in $assignments) {
        if ($null -eq $a -or $null -eq $a.properties) { continue }
        $assignmentScope = [string] $a.properties.scope
        if ($assignmentScope -and $assignmentScope.TrimEnd('/') -ine $scope.TrimEnd('/')) {
            $Node.FilteredAssignmentCount++
            continue
        }
        $policyId = [string] $a.properties.policyId
        $roleId = [string] $a.properties.roleDefinitionId
        $policy = $null
        if ($policyId -and $byId.ContainsKey($policyId.TrimEnd('/'))) {
            $policy = $byId[$policyId.TrimEnd('/')]
        }
        elseif ($policyId) {
            try {
                $policy = Invoke-ArmJson -Path ('{0}?api-version=2020-10-01' -f $policyId.TrimEnd('/'))
            }
            catch {
                Add-ReportError -ScopeId $scope -Operation 'Get linked policy' -Message $_.Exception.Message
            }
        }
        New-PolicyRecord -Node $Node -Assignment $a -Policy $policy -PolicyId $policyId -RoleDefinitionId $roleId
        if ($policyId) { $matched[$policyId.TrimEnd('/')] = $true }
    }
    foreach ($p in $policies) {
        if ($p.id -and -not $matched.ContainsKey(([string] $p.id).TrimEnd('/'))) {
            New-PolicyRecord -Node $Node -Assignment $null -Policy $p -PolicyId $p.id -RoleDefinitionId ''
        }
    }
    $missingRuleRecords = @($Node.Policies | Where-Object { $_.Rules.Count -eq 0 }).Count
    if ($missingRuleRecords -gt 0) {
        Add-ReportError -ScopeId $scope -Operation 'Missing rule payloads' -Message "$missingRuleRecords policy records lack their rule payload."
    }
    if (-not $assignmentsOK -or -not $policiesOK -or $missingRuleRecords -gt 0) { $Node.Status = 'PARTIAL / ERROR' }
    elseif ($Node.Policies.Count -eq 0) { $Node.Status = 'Zero local policies returned (unverified)' }
    else { $Node.Status = 'OK' }
}

function Resolve-RoleName {
    param([string] $RoleDefinitionId)
    if (-not $RoleDefinitionId) { return '[Unmapped policy]' }
    $guid = ($RoleDefinitionId.TrimEnd('/') -split '/')[-1]
    if ($script:RoleNames.ContainsKey($guid)) { return $script:RoleNames[$guid] }
    if ($NoRoleNameResolution) {
        $script:RoleNames[$guid] = $guid
        return $guid
    }
    $name = $guid
    try {
        $role = Invoke-ArmJson -Path ('{0}?api-version=2022-04-01' -f $RoleDefinitionId.TrimEnd('/'))
        if ($role.properties.roleName) { $name = [string] $role.properties.roleName }
    }
    catch {
        # Non-critical: the unambiguous role-definition GUID is retained.
        Write-Verbose "Role-name lookup failed for $RoleDefinitionId : $($_.Exception.Message)"
    }
    $script:RoleNames[$guid] = $name
    return $name
}

function Get-DisplayChildren {
    param($Node)
    foreach ($c in @($Node.Children | Sort-Object @{ Expression = {
        switch ($_.Kind) {
            'ManagementGroup' { 0 }
            'Subscription' { 1 }
            'ResourceGroup' { 2 }
            default { 3 }
        }
    } }, Name)) {
        if ($c.Kind -in @('ManagementGroup', 'Subscription')) { Write-Output $c; continue }
        if ($c.Policies.Count -gt 0 -or $c.Status -match 'ERROR') { Write-Output $c; continue }
        if ($c.Kind -eq 'ResourceGroup') {
            $hasVisibleDescendant = @($c.Children | Where-Object { $_.Policies.Count -gt 0 -or $_.Status -match 'ERROR' }).Count -gt 0
            if ($hasVisibleDescendant) { Write-Output $c }
        }
    }
}

function Get-PolicyLine {
    param($Record)
    $s = $Record.Summary
    return ('Activation: max={0}; MFA={1}; justification={2}; ticket={3}; approval={4}; CA context={5}; Eligible: permanent={6}, max={7}; Active: permanent={8}, max={9}; notification rules={10}' -f
        $(if ($s.ActivationMaxDuration) { $s.ActivationMaxDuration } else { '?' }),
        (Bool-Text $s.ActivationMFA), (Bool-Text $s.ActivationJustification), (Bool-Text $s.ActivationTicket),
        (Bool-Text $s.ActivationApproval), (Bool-Text $s.ConditionalAccessContextEnabled),
        (Bool-Text $s.EligiblePermanentAllowed), $(if ($s.EligibleMaxDuration) { $s.EligibleMaxDuration } else { '?' }),
        (Bool-Text $s.ActivePermanentAllowed), $(if ($s.ActiveMaxDuration) { $s.ActiveMaxDuration } else { '?' }),
        $s.NotificationRuleCount)
}

function Add-TextTree {
    param($Node, [string] $Prefix = '', [bool] $IsLast = $true, [bool] $IsRoot = $false)
    $connector = if ($IsRoot) { '' } elseif ($IsLast) { '+-- ' } else { '|-- ' }
    $label = '[{0}] {1} ({2}) : {3} policies [{4}]' -f $Node.Kind, $Node.Name, $Node.Id, $Node.Policies.Count, $Node.Status
    [void] $script:Txt.AppendLine("$Prefix$connector$label")
    $nextPrefix = if ($IsRoot) { '' } elseif ($IsLast) { "$Prefix    " } else { "$Prefix|   " }

    $items = [System.Collections.Generic.List[object]]::new()
    foreach ($p in @($Node.Policies | Sort-Object RoleName, PolicyId)) {
        [void] $items.Add([pscustomobject] @{ Type = 'Policy'; Value = $p })
    }
    foreach ($c in @(Get-DisplayChildren -Node $Node)) {
        [void] $items.Add([pscustomobject] @{ Type = 'Scope'; Value = $c })
    }
    for ($i = 0; $i -lt $items.Count; $i++) {
        $item = $items[$i]
        $last = $i -eq ($items.Count - 1)
        if ($item.Type -eq 'Scope') {
            Add-TextTree -Node $item.Value -Prefix $nextPrefix -IsLast $last
        }
        else {
            $branch = if ($last) { '+-- ' } else { '|-- ' }
            [void] $script:Txt.AppendLine("$nextPrefix$branch[Role] $($item.Value.RoleName)")
            $rulePrefix = if ($last) { "$nextPrefix    " } else { "$nextPrefix|   " }
            [void] $script:Txt.AppendLine("$rulePrefix$(Get-PolicyLine -Record $item.Value)")
            if ($item.Value.Summary.ApprovalApprovers) {
                [void] $script:Txt.AppendLine("${rulePrefix}Approvers: $($item.Value.Summary.ApprovalApprovers)")
            }
            if ($item.Value.Summary.ConditionalAccessContextEnabled -eq $true) {
                [void] $script:Txt.AppendLine("${rulePrefix}Authentication context ID: $($item.Value.Summary.ConditionalAccessContextId)")
            }
        }
    }
}

function Html {
    param($Value)
    return [System.Net.WebUtility]::HtmlEncode([string] $Value)
}

function Add-HtmlTree {
    param($Node, [int] $Depth = 0)
    $open = if ($Depth -lt 2) { ' open' } else { '' }
    $caption = '[{0}] {1} - {2} policies [{3}]' -f $Node.Kind, $Node.Name, $Node.Policies.Count, $Node.Status
    [void] $script:HtmlBody.AppendLine("<details class='scope'$open><summary>$(Html $caption)</summary>")
    [void] $script:HtmlBody.AppendLine("<div class='id'>$(Html $Node.Id)</div>")
    foreach ($p in @($Node.Policies | Sort-Object RoleName, PolicyId)) {
        [void] $script:HtmlBody.AppendLine('<details class="role"><summary>' + (Html ($p.RoleName + ' | ' + (Get-PolicyLine -Record $p))) + '</summary>')
        [void] $script:HtmlBody.AppendLine("<div class='id'>Policy: $(Html $p.PolicyId)</div>")
        [void] $script:HtmlBody.AppendLine('<div class="id">Complete ARM rules (effective where provided):</div>')
        $raw = ConvertTo-Json -InputObject $p.Rules -Depth 100
        [void] $script:HtmlBody.AppendLine('<pre>' + (Html $raw) + '</pre></details>')
    }
    foreach ($child in @(Get-DisplayChildren -Node $Node)) { Add-HtmlTree -Node $child -Depth ($Depth + 1) }
    [void] $script:HtmlBody.AppendLine('</details>')
}

# 1. Discover the hierarchy, or explicitly target a single subscription to diagnose access.
if ($SubscriptionId) {
    $script:RootNode = Add-Node -Id "/subscriptions/$SubscriptionId" -Name $SubscriptionId -Kind 'Subscription'
}
else {
    $mgPath = '/providers/Microsoft.Management/managementGroups/{0}?api-version=2020-05-01&$expand=children&$recurse=true' -f [uri]::EscapeDataString($ManagementGroupId)
    try { $mg = Invoke-ArmJson -Path $mgPath }
    catch { throw "Cannot read starting management group '$ManagementGroupId'. Check tenant/context and Reader permissions. $($_.Exception.Message)" }
    $rootName = if ($mg.properties.displayName) { [string] $mg.properties.displayName } else { $mg.name }
    $script:RootNode = Add-Node -Id $mg.id -Name $rootName -Kind 'ManagementGroup'
    Add-ManagementGroupChildren -Children $mg.properties.children -ParentId $script:RootNode.Id
    if ($script:AllNodes.Count -eq 1) {
        Write-Warning 'Only the starting management group was returned. This can be a visibility/scope problem; the report does not establish tenant-wide coverage.'
    }
}

# 2. Scan management groups and subscriptions FIRST, so data can be checkpointed
# even if a later resource-group enumeration stalls or fails.
function Invoke-ScanNode {
    param([Parameter(Mandatory)] $Node)
    try {
        Read-ScopePolicies -Node $Node
    }
    catch {
        $Node.Status = 'PARTIAL / ERROR'
        Add-ReportError -ScopeId $Node.Id -Operation 'Unexpected scope processing exception' -Message $_.Exception.Message
    }
    finally {
        Write-ScopeRecord -Node $Node
    }
}
foreach ($node in @($script:AllNodes.ToArray())) {
    Invoke-ScanNode -Node $node
}

# 3. For deeper scans, enumerate and query each resource group as it is found.
# A failing subscription no longer holds up the entire management-group report.
if ($ScopeDepth -ne 'ManagementGroupsAndSubscriptions') {
    $subscriptions = @($script:AllNodes | Where-Object { $_.Kind -eq 'Subscription' })
    foreach ($sub in $subscriptions) {
        try {
            foreach ($rg in @(Get-ArmList -Path ('{0}/resourceGroups?api-version=2021-04-01' -f $sub.Id))) {
                if (-not $rg.id) { continue }
                $rgNode = Add-Node -Id $rg.id -Name $rg.name -Kind 'ResourceGroup' -ParentId $sub.Id
                Invoke-ScanNode -Node $rgNode
            }
        }
        catch {
            Add-ReportError -ScopeId $sub.Id -Operation 'List/scan resource groups' -Message $_.Exception.Message
        }
        if ($ScopeDepth -eq 'Resources') {
            try {
                foreach ($resource in @(Get-ArmList -Path ('{0}/resources?api-version=2021-04-01' -f $sub.Id))) {
                    if (-not $resource.id) { continue }
                    # Avoid recursively querying PIM metadata objects.
                    if ([string] $resource.type -match '(?i)^Microsoft.Authorization/(roleManagement|roleAssignment|roleEligibility)') { continue }
                    $rgPrefix = ''
                    if ([string] $resource.id -match '(?i)^(/subscriptions/[^/]+/resourceGroups/[^/]+)') {
                        $rgPrefix = $Matches[1]
                    }
                    $parent = if ($rgPrefix -and $script:Nodes.ContainsKey($rgPrefix)) { $rgPrefix } else { $sub.Id }
                    $resourceName = '{0}/{1}' -f $resource.type, $resource.name
                    $resourceNode = Add-Node -Id $resource.id -Name $resourceName -Kind 'Resource' -ParentId $parent
                    Invoke-ScanNode -Node $resourceNode
                }
            }
            catch {
                Add-ReportError -ScopeId $sub.Id -Operation 'List/scan resources' -Message $_.Exception.Message
            }
        }
    }
}
Write-Progress -Activity 'Reading Azure PIM settings' -Completed

# 4. Resolve role names once per unique role-definition GUID.
foreach ($p in $script:AllPolicies) {
    $p.RoleName = Resolve-RoleName -RoleDefinitionId $p.RoleDefinitionId
}

# 5. Emit auditable local files.
$script:Txt = [System.Text.StringBuilder]::new()
$reportRoot = $(if ($SubscriptionId) { "subscription=$SubscriptionId" } else { "root MG=$ManagementGroupId" })
[void] $script:Txt.AppendLine("Azure resource PIM settings | tenant=$($context.Tenant.Id) | $reportRoot | coverage=$ScopeDepth | generated UTC=$([datetime]::UtcNow.ToString('o'))")
[void] $script:Txt.AppendLine('PIM role settings are independent per Azure scope. Tree position does NOT indicate settings inheritance.')
[void] $script:Txt.AppendLine('A question mark means a required rule was not returned; consult the raw rules JSON for all details.')
[void] $script:Txt.AppendLine()
Add-TextTree -Node $script:RootNode -IsRoot $true
[System.IO.File]::WriteAllText("${stem}_tree.txt", $script:Txt.ToString(), [System.Text.UTF8Encoding]::new($true))

$script:HtmlBody = [System.Text.StringBuilder]::new()
Add-HtmlTree -Node $script:RootNode
$htmlPage = @'
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Azure PIM policies by scope</title><style>
body{font:14px/1.5 system-ui,Segoe UI,Arial,sans-serif;max-width:1350px;margin:auto;padding:24px;color:#202733;background:#f8fafc}
h1{font-size:24px;margin-bottom:6px}p{color:#44546a}details{margin:7px 0 7px 15px;padding:7px 12px;border-left:2px solid #b3c4d6;background:white;border-radius:4px}
summary{cursor:pointer;font-weight:600;overflow-wrap:anywhere}.role{border-left-color:#4c76ac;background:#f7faff}.role summary{font-weight:500}
.id{font-size:11px;color:#536176;overflow-wrap:anywhere;margin:4px 0 7px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.4 Consolas,monospace;background:#eef2f6;padding:12px;border-radius:5px}
</style></head><body><h1>Azure resource PIM role settings</h1>
'@
$htmlPage += '<p>' + (Html "Tenant $($context.Tenant.Id). Starting scope: $reportRoot. Coverage: $ScopeDepth. Generated UTC: $([datetime]::UtcNow.ToString('o')).") + '</p>'
$htmlPage += '<p>Scopes are displayed hierarchically; PIM role settings do not inherit. Expand a role to see every effective ARM rule, including approvers and notifications. Lower-level scopes without returned policies are hidden unless they have errors. See the CSV and JSON for the full inventory.</p>'
$htmlPage += $script:HtmlBody.ToString() + '</body></html>'
[System.IO.File]::WriteAllText("${stem}_tree.html", $htmlPage, [System.Text.UTF8Encoding]::new($true))

$summaryRows = foreach ($p in $script:AllPolicies) {
    [pscustomobject] @{
        ScopeKind = $p.ScopeKind; ScopeName = $p.ScopeName; ScopeId = $p.ScopeId
        RoleName = $p.RoleName; RoleDefinitionId = $p.RoleDefinitionId; PolicyId = $p.PolicyId
        IsOrganisationDefault = $p.IsOrganisationDefault; LastModified = $p.LastModified
        ActivationMaxDuration = $p.Summary.ActivationMaxDuration
        ActivationMFA = $p.Summary.ActivationMFA
        ActivationJustification = $p.Summary.ActivationJustification
        ActivationTicket = $p.Summary.ActivationTicket
        ActivationApproval = $p.Summary.ActivationApproval
        ApprovalApprovers = $p.Summary.ApprovalApprovers
        ConditionalAccessContextEnabled = $p.Summary.ConditionalAccessContextEnabled
        ConditionalAccessContextId = $p.Summary.ConditionalAccessContextId
        EligiblePermanentAllowed = $p.Summary.EligiblePermanentAllowed
        EligibleMaxDuration = $p.Summary.EligibleMaxDuration
        ActivePermanentAllowed = $p.Summary.ActivePermanentAllowed
        ActiveMaxDuration = $p.Summary.ActiveMaxDuration
        NotificationRuleCount = $p.Summary.NotificationRuleCount
    }
}
if (@($summaryRows | Where-Object { $null -ne $_ }).Count -gt 0) {
    $summaryRows | Export-Csv -Path "${stem}_policies.csv" -NoTypeInformation -Encoding utf8
} else {
    Set-Content -Path "${stem}_policies.csv" -Value 'ScopeKind,ScopeName,ScopeId,RoleName,RoleDefinitionId,PolicyId,IsOrganisationDefault,LastModified,ActivationMaxDuration,ActivationMFA,ActivationJustification,ActivationTicket,ActivationApproval,ApprovalApprovers,ConditionalAccessContextEnabled,ConditionalAccessContextId,EligiblePermanentAllowed,EligibleMaxDuration,ActivePermanentAllowed,ActiveMaxDuration,NotificationRuleCount' -Encoding utf8
}

$ruleRows = foreach ($p in $script:AllPolicies) {
    foreach ($rule in @($p.Rules)) {
        if ($null -eq $rule) { continue }
        [pscustomobject] @{
            ScopeId = $p.ScopeId; ScopeName = $p.ScopeName; RoleName = $p.RoleName
            PolicyId = $p.PolicyId; RuleId = $rule.id; RuleType = $rule.ruleType
            Caller = $rule.target.caller; Level = $rule.target.level
            RuleJson = (ConvertTo-Json -InputObject $rule -Depth 100 -Compress)
        }
    }
}
if (@($ruleRows | Where-Object { $null -ne $_ }).Count -gt 0) {
    $ruleRows | Export-Csv -Path "${stem}_rules.csv" -NoTypeInformation -Encoding utf8
} else {
    Set-Content -Path "${stem}_rules.csv" -Value 'ScopeId,ScopeName,RoleName,PolicyId,RuleId,RuleType,Caller,Level,RuleJson' -Encoding utf8
}

$inventory = [pscustomobject] @{
    TenantId = [string] $context.Tenant.Id
    StartingManagementGroup = $ManagementGroupId
    StartingSubscription = $SubscriptionId
    ScopeDepth = $ScopeDepth
    GeneratedUtc = [datetime]::UtcNow.ToString('o')
    CollectionErrors = $script:Errors.Count
    LiveJournalWriteFailures = $script:JournalWriteFailures
    PolicyRecoveryFiles = $script:RecoveredPolicyWrites
    RG404Verification = 'RG existence checked only after a PIM endpoint 404; policy API 404 alone is not evidence that an RG is absent.' 
    PolicySettingsCompleteForScannedScopes = ($script:Errors.Count -eq 0 -and $script:AllPolicies.Count -gt 0)
    Warning = $(if ($script:AllPolicies.Count -eq 0) { 'Zero PIM settings obtained. Do not interpret this as evidence that PIM is unconfigured.' } else { $null })
    Scopes = @(foreach ($n in $script:AllNodes) {
        [pscustomobject] @{
            Id = $n.Id; ParentId = $n.ParentId; Kind = $n.Kind; Name = $n.Name
            Status = $n.Status; PolicyCount = $n.Policies.Count
            ApiAssignmentCount = $n.ApiAssignmentCount; ApiPolicyCount = $n.ApiPolicyCount
            FilteredAssignmentCount = $n.FilteredAssignmentCount; FilteredPolicyCount = $n.FilteredPolicyCount
        }
    })
    Policies = @($script:AllPolicies.ToArray())
    Requests = @($script:Requests.ToArray())
    Errors = @($script:Errors.ToArray())
}
$inventory | ConvertTo-Json -Depth 100 | Set-Content -Path "${stem}_full.json" -Encoding utf8
$inventory.Scopes | Export-Csv -Path "${stem}_scopes.csv" -NoTypeInformation -Encoding utf8
if ($script:Requests.Count -gt 0) {
    $script:Requests.ToArray() | Export-Csv -Path "${stem}_requests.csv" -NoTypeInformation -Encoding utf8
}
if ($script:Errors.Count -gt 0) {
    $script:Errors.ToArray() | Export-Csv -Path "${stem}_errors.csv" -NoTypeInformation -Encoding utf8
} else {
    Set-Content -Path "${stem}_errors.csv" -Value 'ScopeId,Operation,Error' -Encoding utf8
}

$scanned = @($script:AllNodes | Where-Object { $_.Status -ne 'Not scanned' }).Count
Write-Host "Report: $out" -ForegroundColor Cyan
Write-Host "Scopes scanned: $scanned; policies: $($script:AllPolicies.Count); API/scan errors: $($script:Errors.Count); live journal write failures: $($script:JournalWriteFailures)"
Write-Host "Tree: ${stem}_tree.html"
Write-Host "Text: ${stem}_tree.txt"
Write-Host "Policies: ${stem}_policies.csv; rules: ${stem}_rules.csv"
Write-Host "Raw JSON: ${stem}_full.json; errors: ${stem}_errors.csv"
Write-Host "Diagnostics: ${stem}_scopes.csv; ${stem}_requests.csv"
Write-Host "During-scan journals: ${stem}_scopes.live.csv; ${stem}_requests.live.csv; ${stem}_errors.live.csv"
Write-Host "Durable partial policy data: ${stem}_policies.partial.jsonl"
if ($script:RecoveredPolicyWrites -gt 0) { Write-Warning "$($script:RecoveredPolicyWrites) policies saved in the recovery directory: $script:PolicyRecoveryDirectory" }
if ($script:JournalWriteFailures -gt 0) { Write-Warning 'Some live journals were unavailable. Use the final CSV/JSON exports for the complete collected results.' }
$discoveredSubs = @($script:AllNodes | Where-Object { $_.Kind -eq 'Subscription' }).Count
Write-Host "Subscription scopes discovered: $discoveredSubs"
if ($script:Errors.Count -gt 0) {
    Write-Warning 'Report is INCOMPLETE. Review errors.csv and the coverage setting before using it for audit decisions.'
}
if ($script:AllPolicies.Count -eq 0) {
    Write-Warning 'ZERO POLICIES RETRIEVED. Do not use this report as evidence that PIM is absent. Check scopes.csv, requests.csv and test one known accessible subscription with the Az.Resources cmdlets.'
    if (-not $AllowEmpty) {
        throw 'No PIM role policies were retrieved. Diagnostic files were saved. Use -AllowEmpty only if an empty scan is expected.'
    }
}
if ($script:Errors.Count -gt 0 -and $FailOnErrors) {
    throw "$($script:Errors.Count) ARM errors; report incomplete. Diagnostic files were saved."
}
